# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://www.googletagmanager.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://cloudflareinsights.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Fonts and images swap by filename, so cache for a day rather than forever.
/assets/*
  Cache-Control: public, max-age=86400

# The page and stylesheet are tiny: always revalidate so an HTML/CSS
# pairing can never go stale against each other after a deploy.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/eco.js
  Cache-Control: no-cache
/contact.js
  Cache-Control: no-cache
/analytics.js
  Cache-Control: no-cache
/consent.js
  Cache-Control: no-cache

# Machine-readable copies of the page. Served as UTF-8 text so the em dashes
# and middots survive, and revalidated so they never trail the page.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache
